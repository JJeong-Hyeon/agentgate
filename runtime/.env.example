AGENTGATE_BASE_URL=http://localhost:8080
AGENTGATE_AGENT_ID=runtime-agent
AGENTGATE_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
# native (function calling) | json (for models/servers without function calling)
LLM_TOOL_CALLING=native
RUNTIME_DATABASE_URL=
# Required; the same value as AgentGate's AGENTGATE_RUNTIME_TOKEN. For a runtime alone on your machine
# you can instead set RUNTIME_ALLOW_NO_TOKEN=true (anyone who can reach the port can then use it).
RUNTIME_TOKEN=
MCP_CONFIG_PATH=
