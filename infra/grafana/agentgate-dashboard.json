{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Grafana Cloud의 Prometheus(Mimir) 데이터소스를 선택",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "AgentGate",
  "uid": "agentgate-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "요청량 (req/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"agentgate\"}[5m]))",
          "legendFormat": "requests/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "URI별 요청량",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"agentgate\"}[5m]))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx 에러율",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"agentgate\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM 힙 메모리 사용량",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"agentgate\",area=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "프로세스 CPU 사용률",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"agentgate\"}",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "업타임",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "process_uptime_seconds{job=\"agentgate\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "거버넌스 · Agent",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "거버넌스 판정 (건/분)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(agentgate_governance_decisions_total{job=\"agentgate\"}[5m])) * 60",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "차단 근거 (건/분)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (basis) (rate(agentgate_governance_decisions_total{job=\"agentgate\",status=\"BLOCKED\"}[5m])) * 60",
          "legendFormat": "{{basis}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "대기 중인 승인",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "agentgate_approvals_pending{job=\"agentgate\"}",
          "legendFormat": "pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "승인 대기 시간 (평균)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(agentgate_approval_wait_seconds_sum{job=\"agentgate\"}[1h])) / sum by (outcome) (rate(agentgate_approval_wait_seconds_count{job=\"agentgate\"}[1h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "실행 결과 (건/시간)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(agentgate_execution_duration_seconds_count{job=\"agentgate\"}[1h])) * 3600",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "실행 소요 시간 (평균, 워크플로별)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (workflow) (rate(agentgate_execution_duration_seconds_sum{job=\"agentgate\"}[1h])) / sum by (workflow) (rate(agentgate_execution_duration_seconds_count{job=\"agentgate\"}[1h]))",
          "legendFormat": "{{workflow}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "LLM 응답 시간 (평균, 모델별)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(agentgate_llm_latency_seconds_sum{job=\"agentgate\"}[5m])) / sum by (model) (rate(agentgate_llm_latency_seconds_count{job=\"agentgate\"}[5m]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "LLM 토큰 (토큰/분)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (model, direction) (rate(agentgate_llm_tokens_total{job=\"agentgate\"}[5m])) * 60",
          "legendFormat": "{{model}} {{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Tool 실행 시간 (평균, Tool별)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(agentgate_tool_duration_seconds_sum{job=\"agentgate\"}[5m])) / sum by (tool) (rate(agentgate_tool_duration_seconds_count{job=\"agentgate\"}[5m]))",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Tool 실패율",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (tool) (rate(agentgate_tool_duration_seconds_count{job=\"agentgate\",status=\"FAILED\"}[15m])) / sum by (tool) (rate(agentgate_tool_duration_seconds_count{job=\"agentgate\"}[15m]))",
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    }
  ]
}
