# Copy to ~/agentgate-runtime/.env on the runtime EC2 and fill in. Never commit the real file.
AGENTGATE_BASE_URL=http://<app_private_ip>:8080
AGENTGATE_AGENT_ID=runtime-agent
RUNTIME_TOKEN=<AgentGate의 AGENTGATE_RUNTIME_TOKEN과 같은 값>
RUNTIME_DATABASE_URL=postgresql://agentgate:<RDS 비밀번호>@<rds_endpoint>/agentgate
LLM_MODEL=qwen2.5:3b

# External LLM server instead of the bundled Ollama (e.g. vLLM on NVIDIA DGX Spark).
# The runtime EC2 must be able to reach it. Leave LLM_BASE_URL unset to use Ollama.
#LLM_BASE_URL=http://<llm server>:8000/v1
#LLM_API_KEY=<if vLLM runs with --api-key>
# native: OpenAI function calling (vLLM with --enable-auto-tool-choice --tool-call-parser <parser>)
# json:   tools described in the prompt, for servers/models without function calling
#LLM_TOOL_CALLING=native
# Thinking of reasoning models (qwen3, ...): none (fast), minimal, low, medium, high; unset → model decides.
#LLM_REASONING_EFFORT=none
# true: run every tool call of a model turn; false (default): only the first, the model decides the rest after its result.
#LLM_PARALLEL_TOOL_CALLS=false

# Agent traces with OpenTelemetry (OTLP/HTTP), e.g. Langfuse or Jaeger. Empty → off.
#OTEL_EXPORTER_OTLP_ENDPOINT=https://<langfuse host>/api/public/otel
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>
#OTEL_CAPTURE_CONTENT=false
