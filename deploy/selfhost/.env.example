# Release to install, e.g. 0.1.0 (docker compose pull). Empty: build from this checkout (docker compose up --build).
AGENTGATE_VERSION=

# Copy to .env next to compose.yaml and fill in. Never commit the real file.
# Generate secrets with: openssl rand -hex 32   (AGENTGATE_SECRET_KEY: openssl rand -base64 32)

# Console address. A public domain gets a Let's Encrypt certificate automatically (ports 80/443 must be reachable);
# "localhost" uses Caddy's internal CA.
AGENTGATE_DOMAIN=agentgate.example.com

# First ADMIN account, created only when there are no users yet.
AGENTGATE_ADMIN_USERNAME=admin
AGENTGATE_ADMIN_PASSWORD=

# Letters and digits only: it is also used inside the runtime's database URL.
POSTGRES_PASSWORD=
# Shared secret between AgentGate and the runtime.
RUNTIME_TOKEN=
# AES-256 key for credentials stored in the database (MCP server headers). Back it up: losing it loses them.
AGENTGATE_SECRET_KEY=

# Your OpenAI-compatible model server: Ollama or vLLM, e.g. on an NVIDIA DGX Spark in the same network.
# Ollama on another machine:  http://<model server ip>:11434/v1   (see docs/SELF_HOSTING.md)
# A server on this host:      http://host.docker.internal:<port>/v1
LLM_BASE_URL=http://<model server ip>:11434/v1
LLM_MODEL=<model name, e.g. qwen3:14b-q4_K_M>
LLM_API_KEY=
# native: OpenAI function calling (Ollama with a tool-capable model such as qwen3; vLLM with
#         --enable-auto-tool-choice --tool-call-parser <parser>)
# json:   tools described in the prompt, for servers/models without function calling
LLM_TOOL_CALLING=native
# Seconds to wait for one model answer; raise it for large or reasoning models.
LLM_TIMEOUT_SECONDS=120
# How much reasoning models (e.g. qwen3) think before answering: none, minimal, low, medium, high.
# none is much faster (qwen3:14b on Ollama: ~10s → ~1s per call); agents can override it.
# Empty → not sent, the model decides.
LLM_REASONING_EFFORT=none
# false: of several tool calls in one model turn only the first runs, and the model decides the rest
# after seeing its result (local models otherwise guess arguments, e.g. a refund amount before the lookup).
LLM_PARALLEL_TOOL_CALLS=false
# Model calls sent to the model server at once; the rest wait in the runtime without using up LLM_TIMEOUT_SECONDS.
# 0 = no limit. For Ollama match OLLAMA_NUM_PARALLEL; vLLM batches well and usually needs no limit.
LLM_MAX_CONCURRENCY=0

# Optional: embedding model for semantic search over agent memories (OpenAI-compatible /embeddings).
# Ollama: EMBEDDING_BASE_URL=http://<model server ip>:11434/v1, EMBEDDING_MODEL=bge-m3 (ollama pull bge-m3)
# Empty → memories are searched by keywords.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Least cosine similarity for a memory to count as related. Depends on the model: about 0.45 for bge-m3
# (Korean: related pairs scored 0.55-0.73, unrelated ones about 0.30).
MEMORY_MIN_SCORE=0.45

# Optional: export agent traces with OpenTelemetry (OTLP/HTTP) to Langfuse, Jaeger, Tempo, ...
# Langfuse: OTEL_EXPORTER_OTLP_ENDPOINT=https://<langfuse host>/api/public/otel
#           OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# true exports prompts, answers and tool arguments on spans; leave false for sensitive data.
OTEL_CAPTURE_CONTENT=false

# Optional: Prometheus + Grafana (docker compose --profile monitoring up -d), at https://<domain>/grafana
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=30d

# Optional
AGENTGATE_APPROVAL_TTL=PT24H
# Ended executions (and their runtime checkpoints) are deleted after this; P0D keeps them. Audit logs are kept.
AGENTGATE_EXECUTION_RETENTION=P90D
# Failed console sign-ins: block a username from one IP after this many in a row, an IP after this many in total.
AGENTGATE_LOGIN_MAX_FAILURES=5
AGENTGATE_LOGIN_MAX_FAILURES_PER_IP=20
AGENTGATE_LOGIN_LOCK_DURATION=PT15M
AGENTGATE_NOTIFY_WEBHOOK_URL=
AGENTGATE_NOTIFY_WEBHOOK_FORMAT=SLACK
AGENTGATE_NOTIFY_WEBHOOK_SECRET=
